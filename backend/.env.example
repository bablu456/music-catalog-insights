# Local Database
DB_URL=jdbc:postgresql://localhost:5432/music_catalog
DB_USERNAME=postgres
DB_PASSWORD=your_postgresql_password

# Neon Database (Production)
NEON_JDBC_URL=jdbc:postgresql://<host>:5432/neondb?sslmode=require
NEON_DB_USERNAME=neondb_owner
NEON_DB_PASSWORD=your_neon_password

# Secrets
GEMINI_API_KEY=your_gemini_api_key
JWT_SECRET=your_jwt_secret_key
